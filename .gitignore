# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# claude code local settings
.claude/settings.local.json

# subagent-driven-development workspace (ledger, briefs, review packages)
.superpowers/

# playwright MCP session artifacts (snapshots, console logs)
.playwright-mcp/

# typescript
*.tsbuildinfo
next-env.d.ts

# arquivos gerados (PDFs, áudios) do módulo de memorial descritivo
/storage/

# assets locais de preview (screenshot/gravação) antes de subir pro S3 e
# entrar no content/releases/*.json — nunca comitados, ficam só na máquina
/preview/
