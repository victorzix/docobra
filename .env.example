# Banco de dados (Postgres). Para os testes de integração, crie também um
# .env.test com DATABASE_URL apontando pra um banco de teste separado
# (ex.: mesmo host, banco "docobra-local-test") — o Vitest carrega esse
# arquivo automaticamente ao rodar em modo "test".
DATABASE_URL="postgresql://usuario:senha@localhost:5432/docobra"

# Camada de LLM — Gemini é o provider default, Claude é fallback pago
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
# Remover "gemini" desabilita memorial por áudio (Claude não transcreve).
LLM_ORDER_MEMORIAL="gemini,claude"
LLM_ORDER_COMUNIQUE_SE="gemini,claude"

# Auth local (bcrypt + JWT)
JWT_SECRET=""

# Só usado dentro do container Docker (Dockerfile já configura). Aponta pro
# Chromium do sistema em vez do embutido do Puppeteer. Deixe vazio localmente.
PUPPETEER_EXECUTABLE_PATH=""

# Publicação de versões no portfólio (npm run release:publish).
# PORTFOLIO_API_URL: base da API do portfólio. Prefira HTTPS — o token vai num
# header Authorization e em HTTP puro trafega em texto claro.
# CHANGELOG_API_TOKEN: mesmo segredo que o servidor do portfólio lê como
# CHANGELOG_API_TOKEN (é o Bearer token do upload). NUNCA commitar o valor real.
PORTFOLIO_API_URL="https://seu-dominio-do-portfolio"
CHANGELOG_API_TOKEN=""
