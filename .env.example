# Banco de dados (Postgres). Para os testes de integração, crie também um
# .env.test com DATABASE_URL apontando pra um banco de teste separado
# (ex.: mesmo host, banco "docobra-local-test") — o Vitest carrega esse
# arquivo automaticamente ao rodar em modo "test".
DATABASE_URL="postgresql://usuario:senha@localhost:5432/docobra"

# Camada de LLM — Gemini é o provider default, Claude é fallback pago
GEMINI_API_KEY=""
ANTHROPIC_API_KEY=""
# Remover "gemini" desabilita memorial por áudio (Claude não transcreve).
LLM_ORDER_MEMORIAL="gemini,claude"
LLM_ORDER_COMUNIQUE_SE="gemini,claude"

# Auth local (bcrypt + JWT)
JWT_SECRET=""

# Só usado dentro do container Docker (Dockerfile já configura). Aponta pro
# Chromium do sistema em vez do embutido do Puppeteer. Deixe vazio localmente.
PUPPETEER_EXECUTABLE_PATH=""

# Storage local do módulo Comunique-se. Deixe vazio pra usar o default
# (storage/comunique-se, relativo à raiz do projeto).
COMUNIQUE_SE_STORAGE_DIR=""

# Publicação de versões no portfólio (npm run release:publish).
# PORTFOLIO_API_URL: base da API do portfólio. Prefira HTTPS — o token vai num
# header Authorization e em HTTP puro trafega em texto claro.
# CHANGELOG_API_TOKEN: mesmo segredo que o servidor do portfólio lê como
# CHANGELOG_API_TOKEN (é o Bearer token do upload). NUNCA commitar o valor real.
PORTFOLIO_API_URL="https://seu-dominio-do-portfolio"
CHANGELOG_API_TOKEN=""

# Planos: enquanto o pagamento não existe, a suspensão por data de vencimento
# fica desligada (só as cotas valem). Ligue ("true") quando existir como pagar.
ASSINATURA_SUSPENSAO_ATIVA="false"

# Planos: email que recebe os pedidos de mudança de plano (botão "Falar com o
# suporte" quando a cota acaba). Sem valor, o botão não aparece.
SUPORTE_EMAIL=""

# Pagamentos (Asaas). Por enquanto SOMENTE sandbox: crie a conta sandbox em
# https://sandbox.asaas.com, gere a API key e configure o webhook (veja
# docs/pagamentos-asaas.md). Sem a chave, o app roda normalmente; só o fluxo de
# cobrança fica indisponível.
ASAAS_API_KEY=""
ASAAS_WEBHOOK_TOKEN=""
ASAAS_BASE_URL="https://api-sandbox.asaas.com"
# Ordem dos provedores de pagamento (fallback só em recusa definitiva).
PAGAMENTOS_ORDEM="asaas"

# Menor valor que uma cobrança pode ter, em centavos. Um upgrade cuja diferença
# proporcional dê menos que isso cobra este mínimo. Valide o valor no sandbox.
PAGAMENTO_VALOR_MINIMO_CENTAVOS="500"

# Segredo da rota que gera as cobranças de renovação (POST /api/cron/renovacoes).
# Agende no Coolify (Scheduled Task, 1x por dia) um curl com
# `Authorization: Bearer <este valor>`. Sem ele a rota responde 503.
CRON_SECRET=""
